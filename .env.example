# Copy to `.env` and fill in real values. `.env` is git-ignored and must never
# be committed.
#
#   cp .env.example .env

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string. The application refuses to serve data without a
# valid one (it fails fast rather than falling back to anything).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Signing key for session tokens. The server will NOT start in production
# without it, and requires at least 32 characters. Generate a random one:
#
#   openssl rand -base64 48
#
# Changing it invalidates every existing session, which is the correct action if
# it is ever exposed.
JWT_SECRET=

# --- Required for docker compose only ---------------------------------------
# These build the DATABASE_URL for the bundled PostgreSQL service.
POSTGRES_USER=pharma_admin
POSTGRES_PASSWORD=
POSTGRES_DB=pharma_regulatory_db

# --- Optional ---------------------------------------------------------------

# `production` serves the built frontend from dist/ and turns on the fail-fast
# checks above. Anything else runs the Vite dev middleware.
NODE_ENV=production

# Build-time only: enables the "local demo" sign-in button that keeps all data
# in the browser. Leave unset for a real deployment.
# VITE_ENABLE_LOCAL_DEMO=true
