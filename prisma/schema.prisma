// Prisma schema — VLSE (Vendor List & Supplier Evaluation System)
// Normalized, per-module relational model on PostgreSQL.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (strong typing for new module tables)
// NOTE: Vendor.status / Vendor.grade / Evaluation.grade / VendorMaterial.category
// are intentionally left as String for backward compatibility with the existing
// server.ts data layer, which reads/writes free-form status/grade strings.
// ---------------------------------------------------------------------------

enum UserRole {
  admin
  lab
  commercial
  qa
  planning
  finance
}

enum BusinessPartnerType {
  Manufacturer
  Supplier
}

enum BusinessPartnerStatus {
  Active
  Inactive
  Blacklisted
}

enum RiskLevel {
  Low
  Medium
  High
}

enum AnalysisDecision {
  Pass
  Reject
  ApprovedConditional
}

enum DeviationReason {
  None
  NCR
  Deviation
  OOS
  CAPA
  OOT
  Complaint
  Other
}

enum SopDocumentKey {
  manufacturerLetter
  authorizedSignatory
  businessLicense
  officialEnglishTranslation
  legalization
}

enum SopDocumentStatus {
  Approved
  PermitApproval
  Expired
  NotSubmitted
}

// ---------------------------------------------------------------------------
// Module: Authentication / Users
// ---------------------------------------------------------------------------

model User {
  username           String    @id @map("username") @db.VarChar(100)
  name               String    @map("name")
  role               UserRole  @default(commercial) @map("role")
  passwordHash       String    @map("password_hash") @db.Text
  passwordSalt       String    @map("password_salt") @db.VarChar(64)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  isActive           Boolean   @default(true) @map("is_active")
  permissions        Json?     @map("permissions")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Module: Materials
// ---------------------------------------------------------------------------

model Material {
  id     String @id @map("id") @db.VarChar(50)
  name   String @map("name")
  nameEn String @map("name_en")
  cas    String @map("cas")
  irc    String @map("irc")

  // Enriched regulatory attributes (optional for backward compatibility)
  iupac             String?  @map("iupac")
  role              String?  @map("role")
  finalProduct      String?  @map("final_product")
  finalProductEn    String?  @map("final_product_en")
  pharmacopoeia     String?  @map("pharmacopoeia")
  standardNameFa    String?  @map("standard_name_fa")
  standardNameEn    String?  @map("standard_name_en")
  // The Specification attachment. `specificationFile` is the file name and has
  // been there all along; the blob and its metadata were added when the upload
  // became real. The blob is never part of a list payload — it is fetched from
  // GET /api/materials/:id/specification/file on demand (project rule 5).
  specificationFile       String?   @map("specification_file")
  specificationFileSize   Int?      @map("specification_file_size")
  specificationFileData   String?   @map("specification_file_data") @db.Text
  specificationUploadedAt DateTime? @map("specification_uploaded_at")
  ircReceiveDate    String?  @map("irc_receive_date")
  ircExpiryDate     String?  @map("irc_expiry_date")
  createdAt         DateTime @default(now()) @map("created_at")

  vendors     VendorMaterial[]
  evaluations Evaluation[]

  @@index([cas])
  @@index([irc])
  @@map("materials")
}

// ---------------------------------------------------------------------------
// Module: Business Partners (Manufacturers & Suppliers) + SOP evaluation
// ---------------------------------------------------------------------------

model BusinessPartner {
  id            String                @id @map("id") @db.VarChar(50)
  type          BusinessPartnerType   @map("type")
  name          String                @map("name")
  nameEn        String?               @map("name_en")
  country       String                @map("country")
  city          String?               @map("city")
  address       String?               @map("address") @db.Text
  email         String?               @map("email")
  contactPerson String?               @map("contact_person")
  phone         String?               @map("phone")
  website       String?               @map("website")
  status        BusinessPartnerStatus @default(Active) @map("status")

  // Manufacturers and Suppliers are independent, flat entities: a partner is
  // classified by `type` only; suppliers no longer reference a manufacturer.
  evaluation SupplierEvaluation?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([status])
  @@map("business_partners")
}

model SupplierEvaluation {
  id         String   @id @default(uuid()) @map("id") @db.VarChar(50)
  partnerId  String   @unique @map("partner_id") @db.VarChar(50)
  totalScore Float    @default(0) @map("total_score")
  grade      String   @map("grade")
  status     String   @map("status")
  updatedBy  String?  @map("updated_by")
  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  partner   BusinessPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  documents SopDocument[]

  @@map("supplier_evaluations")
}

model SopDocument {
  id           String             @id @default(uuid()) @map("id") @db.VarChar(50)
  evaluationId String             @map("evaluation_id") @db.VarChar(50)
  key          SopDocumentKey     @map("key")
  nameFa       String             @map("name_fa")
  nameEn       String             @map("name_en")
  status       SopDocumentStatus? @map("status")
  score        Float              @default(0) @map("score")
  fileName     String?            @map("file_name")
  fileSize     Int?               @map("file_size")
  fileDataUrl  String?            @map("file_data_url") @db.Text
  uploadedAt   DateTime?          @map("uploaded_at")

  evaluation SupplierEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, key])
  @@index([evaluationId])
  @@map("sop_documents")
}

// ---------------------------------------------------------------------------
// Module: Vendors + Vendor-Material links + Evaluations
// ---------------------------------------------------------------------------

model Vendor {
  id                  String  @id @map("id") @db.VarChar(50)
  name                String  @map("name")
  nameEn              String  @map("name_en")
  country             String  @map("country")
  contactInfo         String? @map("contact_info") @db.Text
  registrationDate    String? @map("registration_date")
  status              String  @default("new") @map("status")
  grade               String? @map("grade")
  initialSampleStatus String? @map("initial_sample_status")
  // The IRC licence belongs to the source, not to the material catalogue
  // entry. It used to be stored on `materials` *and* folded into the generated
  // material id, so registering a source with an IRC forked a duplicate
  // material row for the same substance.
  irc                 String? @map("irc")
  ircExpiryDate       String? @map("irc_expiry_date")

  // Optional links to normalized business partners
  manufacturerId String? @map("manufacturer_id") @db.VarChar(50)
  supplierId     String? @map("supplier_id") @db.VarChar(50)

  // Legacy embedded JSON (kept for backward compatibility; superseded by the
  // normalized riskAssessments / analysisRecordEntries relations below).
  riskAssessment  String? @map("risk_assessment") @db.Text
  analysisRecords String? @map("analysis_records") @db.Text

  materials             VendorMaterial[]
  evaluations           Evaluation[]
  riskAssessments       RiskAssessment[]
  analysisRecordEntries AnalysisRecord[]
  activityLogs          ActivityLog[]
  sourceSelections      SourceSelection[]

  @@index([status])
  @@index([grade])
  @@index([manufacturerId])
  @@index([supplierId])
  @@map("vendors")
}

model VendorMaterial {
  id         String  @id @map("id") @db.VarChar(50)
  vendorId   String  @map("vendor_id") @db.VarChar(50)
  materialId String  @map("material_id") @db.VarChar(50)
  isSample   Boolean @default(false) @map("is_sample")
  category   String  @map("category")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([vendorId, materialId])
  @@index([materialId])
  @@index([category])
  @@map("vendor_materials")
}

model Evaluation {
  id               String   @id @map("id") @db.VarChar(50)
  vendorId         String   @map("vendor_id") @db.VarChar(50)
  materialId       String   @map("material_id") @db.VarChar(50)
  period           String   @map("period")
  commercialScore  Float    @default(0) @map("commercial_score")
  qaScore          Float    @default(0) @map("qa_score")
  planningScore    Float    @default(0) @map("planning_score")
  financeScore     Float    @default(0) @map("finance_score")
  totalScore       Float    @default(0) @map("total_score")
  grade            String   @map("grade")
  scores           String?  @map("scores") @db.Text
  rawScores        String?  @map("raw_scores") @db.Text
  rejectionReasons String?  @map("rejection_reasons") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([materialId])
  @@index([period])
  @@map("evaluations")
}

// ---------------------------------------------------------------------------
// Module: Risk Assessment (FMEA)
// ---------------------------------------------------------------------------

model RiskAssessment {
  id                  String    @id @default(uuid()) @map("id") @db.VarChar(50)
  vendorId            String    @map("vendor_id") @db.VarChar(50)
  materialCriticality Int       @map("material_criticality")
  detectability       Int       @map("detectability")
  probability         Int       @map("probability")
  sps                 Float     @default(0) @map("sps")
  riskScore           Float     @default(0) @map("risk_score")
  sri                 Float     @default(0) @map("sri")
  riskLevel           RiskLevel @map("risk_level")
  evaluationDate      String?   @map("evaluation_date")
  evaluator           String?   @map("evaluator")
  createdAt           DateTime  @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([riskLevel])
  @@map("risk_assessments")
}

// ---------------------------------------------------------------------------
// Module: Lab Analysis Records
// ---------------------------------------------------------------------------

model AnalysisRecord {
  id              String           @id @default(uuid()) @map("id") @db.VarChar(50)
  vendorId        String           @map("vendor_id") @db.VarChar(50)
  recordDate      String?          @map("record_date")
  qcCode          String?          @map("qc_code")
  decision        AnalysisDecision @map("decision")
  deviationReason DeviationReason  @default(None) @map("deviation_reason")
  comments        String?          @map("comments") @db.Text
  recordedBy      String?          @map("recorded_by")
  createdAt       DateTime         @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([decision])
  @@map("analysis_records")
}

// ---------------------------------------------------------------------------
// Module: Vendor Activity Log (business events, distinct from security audit)
// ---------------------------------------------------------------------------

model ActivityLog {
  id        String   @id @default(uuid()) @map("id") @db.VarChar(50)
  vendorId  String   @map("vendor_id") @db.VarChar(50)
  action    String   @map("action") @db.Text
  user      String   @map("user")
  createdAt DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ---------------------------------------------------------------------------
// Module: Regulatory audit trail (canonical, GxP-style, fully indexed)
// ---------------------------------------------------------------------------

model AuditLog {
  id              String   @id @default(uuid()) @map("id") @db.VarChar(50)
  auditId         String   @unique @map("audit_id") @db.VarChar(50)
  correlationId   String?  @map("correlation_id") @db.VarChar(50)
  timestamp       DateTime @default(now()) @map("timestamp")
  userId          String?  @map("user_id") @db.VarChar(50)
  // The column carries a `fa-IR-x-icu` collation, applied by the migration
  // 20260831180000_audit_user_name_persian_collation, so that the audit table's
  // "sort by user" orders Persian names alphabetically instead of by code point.
  // Prisma has no notation for a column collation, so it lives only in the
  // migration — do not regenerate this column from `db pull` and expect it back.
  userName        String?  @map("user_name") @db.VarChar(100)
  role            String?  @map("role") @db.VarChar(50)
  module          String   @map("module") @db.VarChar(100)
  entityType      String?  @map("entity_type") @db.VarChar(100)
  entityId        String?  @map("entity_id") @db.VarChar(50)
  entityName      String?  @map("entity_name") @db.VarChar(200)
  action          String   @map("action") @db.VarChar(50)
  severity        String   @map("severity") @db.VarChar(50)
  description     String?  @map("description") @db.Text
  reasonForChange String?  @map("reason_for_change") @db.Text
  beforeData      Json?    @map("before_data")
  afterData       Json?    @map("after_data")
  // Metadata about the event, not part of the change itself. These used to be
  // folded into `after_data`, which made them show up as "added fields" in the
  // before/after comparison of every record.
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.Text
  eventType       String?  @map("event_type") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([severity])
  @@index([entityId])
  @@index([correlationId])
  @@map("audit_log")
}

/// The chosen source for one material within one purchasing category.
///
/// The comparison panel could only ever *recommend*; nothing recorded what was
/// actually decided. Under GxP the question an auditor asks is "why did you buy
/// from this supplier", and the answer has to be written down — so the reason is
/// mandatory and the change is mirrored into audit_log like every other write.
///
/// Keyed by the material's English name because that is what the category page
/// groups sources by (CategoryView builds its groups on `materialEn`).
model SourceSelection {
  id          String   @id @default(uuid())
  materialKey String   @map("material_key") @db.VarChar(255)
  category    String   @map("category") @db.VarChar(50)
  vendorId    String   @map("vendor_id")
  reason      String   @map("reason") @db.Text
  decidedBy   String   @map("decided_by") @db.VarChar(100)
  decidedAt   DateTime @default(now()) @map("decided_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([materialKey, category])
  @@index([vendorId])
  @@map("source_selections")
}
